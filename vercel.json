{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/blog", "destination": "/blog/", "permanent": true },
    { "source": "/blog/index.html", "destination": "/blog/", "permanent": true },
    { "source": "/blog/shopify-app-reviews-technical-support", "destination": "/blog/shopify-app-reviews-technical-support/", "permanent": true },
    { "source": "/blog/shopify-app-reviews-technical-support/index.html", "destination": "/blog/shopify-app-reviews-technical-support/", "permanent": true },
    { "source": "/blog/what-makes-a-great-technical-support-specialist", "destination": "/blog/what-makes-a-great-technical-support-specialist/", "permanent": true },
    { "source": "/blog/what-makes-a-great-technical-support-specialist/index.html", "destination": "/blog/what-makes-a-great-technical-support-specialist/", "permanent": true },
    { "source": "/saas-technical-support-philippines", "destination": "/saas-technical-support-philippines/", "permanent": true },
    { "source": "/saas-technical-support-philippines/index.html", "destination": "/saas-technical-support-philippines/", "permanent": true },
    { "source": "/case-studies", "destination": "/case-studies/", "permanent": true },
    { "source": "/case-studies/index.html", "destination": "/case-studies/", "permanent": true },
    { "source": "/case-studies/sysguard-ticketing-system", "destination": "/case-studies/sysguard-ticketing-system/", "permanent": true },
    { "source": "/case-studies/sysguard-ticketing-system/index.html", "destination": "/case-studies/sysguard-ticketing-system/", "permanent": true },
    { "source": "/case-studies/preorder-campaign-widgets", "destination": "/case-studies/preorder-campaign-widgets/", "permanent": true },
    { "source": "/case-studies/preorder-campaign-widgets/index.html", "destination": "/case-studies/preorder-campaign-widgets/", "permanent": true },
    { "source": "/case-studies/essential-apps-support-guide", "destination": "/case-studies/essential-apps-support-guide/", "permanent": true },
    { "source": "/case-studies/essential-apps-support-guide/index.html", "destination": "/case-studies/essential-apps-support-guide/", "permanent": true },
    { "source": "/work-with-me", "destination": "/work-with-me/", "permanent": true },
    { "source": "/work-with-me/index.html", "destination": "/work-with-me/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy/", "permanent": true },
    { "source": "/privacy/index.html", "destination": "/privacy/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
